    shared_among "normal" "locked" {
        // --- Monitor orientation layouts -------------------------------
        // Alt 1: landscape monitor, two panes side by side.
        // Alt 2: portrait monitor, two panes stacked.
        // Both keep running processes; only pane geometry changes, so both
        // layouts must keep the same pane count for the mapping to stay 1:1.
        //
        // These used to shell out to `zellij action override-layout` through a
        // 1%-sized floating pane, because the native action refused to parse
        // whenever default_layout was set ("Tab layout cannot itself have
        // tabs") on the 0.43.1-win32 fork. The native form landed in 0.44 and
        // parses here, so the subprocess, the phantom pane and the hardcoded
        // binary path are all gone -- that path broke twice when the binary
        // moved.
        bind "Alt 1" {
            OverrideLayout {
                layout "{HOME/}/.config/zellij/layouts/orient_wide.kdl"
                retain_existing_terminal_panes true
                retain_existing_plugin_panes true
                apply_only_to_active_tab true
            }
        }
        bind "Alt 2" {
            OverrideLayout {
                layout "{HOME/}/.config/zellij/layouts/orient_tall.kdl"
                retain_existing_terminal_panes true
                retain_existing_plugin_panes true
                apply_only_to_active_tab true
            }
        }
        // --- Stop dev servers ------------------------------------------
        // Alt c: the Ctrl+C that works. Ctrl+C does not reach child
        // processes inside Zellij on Windows -- the key arrives, but what
        // the pane's shell gets has Break semantics rather than an
        // interrupt, so a dev server survives it, survives closing the
        // pane, and keeps holding its port. This kills every dev server
        // running in a pane, from the top of its runner chain so `tsx
        // watch` and friends cannot respawn the child.
        bind "Alt c" {
            Run "pwsh" "-NoProfile" "-File" "{HOME/}/Documents/PowerShell/Scripts/Stop-DevServer.ps1" {
                floating true
                close_on_exit false
                width "60%"
                height "20%"
                x "20%"
                y "40%"
                name "stop dev servers"
            }
        }
        bind "Alt y" {
            LaunchOrFocusPlugin "file:~/.config/zellij/plugins/zellij_forgot.wasm" {
            "lock"                  "ctrl + g"
            "unlock"                "ctrl + g"
            "new pane"              "Alt + n || ctrl + g + p + n"
            "change focus of pane"  "Alt + arrow key || ctrl + g + p + arrow key"
            "close pane"            "ctrl + g + p + x"
            "rename pane"           "ctrl + g + p + c"
            "toggle fullscreen"     "ctrl + g + p + f"
            "toggle floating pane"  "Alt + f || ctrl + g + p + w"
            "toggle embed pane"     "ctrl + g + p + e"
            "choose right pane"     "ctrl + g + p + l"
            "choose left pane"      "ctrl + g + p + r"
            "choose upper pane"     "ctrl + g + p + k"
            "choose lower pane"     "ctrl + g + p + j"
            "new tab"               "ctrl + g + t + n"
            "close tab"             "ctrl + g + t + x"
            "change focus of tab"   "ctrl + g + t + arrow key"
            "rename tab"            "ctrl + g + t + r"
            "sync tab"              "ctrl + g + t + ctrl+s"
            "brake pane to new tab" "ctrl + g + t + b"
            "brake pane left"       "ctrl + g + t + ["
            "brake pane right"      "ctrl + g + t + ]"
            "toggle tab"            "ctrl + g + t + tab"
            "increase pane size"    "ctrl + g + n + +"
            "decrease pane size"    "ctrl + g + n + -"
            "increase pane top"     "ctrl + g + n + k"
            "increase pane right"   "ctrl + g + n + l"
            "increase pane bottom"  "ctrl + g + n + j"
            "increase pane left"    "ctrl + g + n + h"
            "decrease pane top"     "ctrl + g + n + K"
            "decrease pane right"   "ctrl + g + n + L"
            "decrease pane bottom"  "ctrl + g + n + J"
            "decrease pane left"    "ctrl + g + n + H"
            "move pane to top"      "ctrl + g + h + k"
            "move pane to right"    "ctrl + g + h + l"
            "move pane to bottom"   "ctrl + g + h + j"
            "move pane to left"     "ctrl + g + h + h"
            "search"                "ctrl + g + s + s"
            "go into edit mode"     "ctrl + g + s + e"
            "detach session"        "ctrl + g + o + w"
            "open session manager"  "ctrl + g + o + w"
            "quit zellij"           "ctrl + g + q"
            floating true
            }
        }
        // One modifier, one concept: Ctrl moves between tabs, Alt moves between
        // panes. Ctrl h/j/k used to focus panes here, which left three keys on
        // panes and the fourth on tabs; they were exact duplicates of Alt h/j/k,
        // so dropping them costs nothing and keeps the row consistent.
        bind "Ctrl l" { GoToPreviousTab; }
        bind "Ctrl p" { GoToNextTab; }
        // Read back output without entering scroll mode, by emulating the
        // mouse wheel instead of moving Zellij's own viewport.
        //
        // HalfPageScrollUp was the obvious binding here and it does not work,
        // for a reason that took three rounds to pin down: full-screen TUIs
        // (Claude Code, opencode) keep no scrollback in the pane. Measured by
        // printing 300 numbered lines into a pane and then starting Claude
        // Code in it -- `dump-screen --full` went from 306 lines to 21, with
        // zero markers left. Zellij's scroll actions had an empty buffer to
        // move through, so the keys fired and nothing happened. Those TUIs
        // scroll their OWN internal view, which is why the mouse wheel works
        // in them and a Zellij scroll action does not.
        //
        // So send what the wheel sends. SGR mouse encoding is
        // ESC [ < Cb ; col ; row M, with Cb 64 for wheel up and 65 for wheel
        // down; the bytes below are that sequence at column 10, row 10, three
        // ticks per press to match one wheel notch. Verified both ways: the
        // sequence written to a Claude Code pane scrolls it to the top of the
        // conversation, and the same bytes written to a pwsh pane leave no
        // stray characters, so shell panes degrade to a no-op rather than to
        // garbage in the prompt.
        //
        // Cost of keeping this on Ctrl d: Zellij sees the key before the pane,
        // so Claude Code never receives Ctrl+D as its own exit shortcut, and
        // inside WSL or ssh it no longer reaches the remote shell as EOF.
        // Zellij's native viewport scrolling is still reachable in scroll mode
        // through the tmux prefix.
        bind "Ctrl d" {
            Write 27 91 60 54 52 59 49 48 59 49 48 77;
            Write 27 91 60 54 52 59 49 48 59 49 48 77;
            Write 27 91 60 54 52 59 49 48 59 49 48 77;
        }
        bind "Ctrl f" {
            Write 27 91 60 54 53 59 49 48 59 49 48 77;
            Write 27 91 60 54 53 59 49 48 59 49 48 77;
            Write 27 91 60 54 53 59 49 48 59 49 48 77;
        }
        bind "Alt left" { MoveFocusOrTab "left"; }
        bind "Alt down" { MoveFocus "down"; }
        bind "Alt up" { MoveFocus "up"; }
        bind "Alt right" { MoveFocusOrTab "right"; }
        bind "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt =" { Resize "Increase"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
        // Alt+f toggles the floating pane at the Zellij level, on purpose.
        //
        // The shell also binds Alt+f (_zflt in Microsoft.PowerShell_profile.ps1),
        // which would open the pane with --cwd "$PWD" and keep its directory.
        // Zellij sees the key first, so that handler never runs and the pane
        // opens with no cwd. That is the known cost of this binding: it is kept
        // because a Zellij-level key works from every pane, including from
        // inside the floating pane itself and from panes not running pwsh.
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt F" { TogglePanePinned; }
        bind "Alt h" { MoveFocusOrTab "left"; }
        bind "Alt i" { MoveTab "left"; }
        bind "Alt j" { MoveFocus "down"; }
        bind "Alt k" { MoveFocus "up"; }
        // Pane cycling, the Alt mirror of Ctrl l / Ctrl p: "l" previous, "p"
        // next. Cyclic rather than directional on purpose. Alt 1 and Alt 2 flip
        // the layout between side-by-side and stacked, so a directional binding
        // would point the wrong way half the time; cycling does not care about
        // geometry. It also stays inside the tab, where MoveFocusOrTab would
        // jump to the neighbouring tab at the edge and break the split above.
        bind "Alt l" { FocusPreviousPane; }
        bind "Alt p" { FocusNextPane; }
        bind "Alt n" { NewPane; }
        bind "Alt o" { MoveTab "right"; }
    }
    shared_except "locked" "renametab" "renamepane" {
        bind "Ctrl a" { SwitchToMode "tmux"; }
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Ctrl q" { Quit; }
    }
    shared_except "locked" "entersearch" {
        bind "enter" { SwitchToMode "locked"; }
    }
    shared_except "locked" "entersearch" "renametab" "renamepane" {
        bind "esc" { SwitchToMode "locked"; }
    }
    shared_except "locked" "entersearch" "renametab" "renamepane" "move" {
        bind "m" { SwitchToMode "move"; }
    }
    shared_except "locked" "entersearch" "search" "renametab" "renamepane" "session" {
        bind "o" { SwitchToMode "session"; }
    }
    shared_except "locked" "tab" "entersearch" "renametab" "renamepane" {
        bind "t" { SwitchToMode "tab"; }
    }
    shared_except "locked" "tab" "scroll" "entersearch" "renametab" "renamepane" {
        bind "s" { SwitchToMode "scroll"; }
    }
    shared_among "normal" "resize" "tab" "scroll" "prompt" "tmux" {
        bind "p" { SwitchToMode "pane"; }
    }
    shared_among "normal" "resize" "tab" "scroll" "prompt" "tmux" {
        bind "o" { SwitchToMode "session"; }
    }
    shared_except "locked" "resize" "pane" "tab" "entersearch" "renametab" "renamepane" {
        bind "r" { SwitchToMode "resize"; }
    }
    shared_among "scroll" "search" {
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "left" { PageScrollUp; }
        bind "down" { ScrollDown; }
        bind "up" { ScrollUp; }
        bind "right" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "locked"; }
        bind "d" { HalfPageScrollDown; }
        bind "Ctrl f" { PageScrollDown; }
        bind "h" { PageScrollUp; }
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "l" { PageScrollDown; }
        bind "u" { HalfPageScrollUp; }
    }
    entersearch {
        bind "Ctrl c" { SwitchToMode "scroll"; }
        bind "esc" { SwitchToMode "scroll"; }
        bind "enter" { SwitchToMode "search"; }
    }
    renametab {
        bind "esc" { UndoRenameTab; SwitchToMode "tab"; }
    }
    shared_among "renametab" "renamepane" {
        bind "Ctrl c" { SwitchToMode "locked"; }
    }
    renamepane {
        bind "esc" { UndoRenamePane; SwitchToMode "pane"; }
    }
}

// Plugin aliases - can be used to change the implementation of Zellij
// changing these requires a restart to take effect
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

// Plugins to load in the background when a new session starts
// eg. "file:/path/to/my-plugin.wasm"
// eg. "https://example.com/my-plugin.wasm"
load_plugins {
    // Upstream loads "zellij:link" here. That built-in does not exist in
    // 0.43.1-win32.5 and logs "Failed to load plugin" on every session start.
}
 
