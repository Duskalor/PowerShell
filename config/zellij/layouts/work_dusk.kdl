// DuskaDev "Medianoche" layout: same tabs as work_oldWorld, minimal zjstatus bar.
// Palette: bg #0d1320 · panel #172033 · text #d8e0ee · muted #6a7a96
//          amber #f2b84b · blue #5aa9ff · pink #e88fb5
layout {
    tab name="claude" focus=true {
        pane split_direction="vertical" {
            pane size="50%" focus=true
            pane size="50%"
        }
    }

    tab name="opencode" {
        pane split_direction="vertical" {
            pane size="50%" focus=true
            pane size="50%"
        }
    }

    swap_floating_layout {
        floating_panes {
            pane x="15%" y="20%" width="70%" height="60%"
        }
    }

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode}{tabs}"
                format_center "#[fg=#f2b84b,bold]☾ duskadev"
                format_right  "{command_git_branch}#[fg=#6a7a96]· {datetime}"
                format_space  "#[bg=#0d1320]"

                border_enabled  "false"

                // Text only, no blocks: the mode is a colored word, amber by default.
                // default_mode is "locked", so locked is what shows most of the time.
                mode_normal        "#[fg=#f2b84b,bold] NORMAL "
                mode_locked        "#[fg=#f2b84b,bold] LOCKED "
                mode_pane          "#[fg=#5aa9ff,bold] PANE "
                mode_tab           "#[fg=#5aa9ff,bold] TAB "
                mode_resize        "#[fg=#e88fb5,bold] RESIZE "
                mode_move          "#[fg=#e88fb5,bold] MOVE "
                mode_scroll        "#[fg=#4fd1c5,bold] SCROLL "
                mode_search        "#[fg=#4fd1c5,bold] SEARCH "
                mode_session       "#[fg=#8fd18f,bold] SESSION "
                mode_tmux          "#[fg=#ef6b73,bold] TMUX "
                mode_default_to_mode "normal"

                tab_normal   "#[fg=#6a7a96] {index}:{name} "
                tab_active   "#[fg=#d8e0ee,bold,underline] {index}:{name} "

                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=#5aa9ff]⎇ {stdout} "
                command_git_branch_interval    "10"
                command_git_branch_rendermode  "static"

                datetime          "#[fg=#6a7a96]{format} "
                datetime_format   "%a %d %b  %H:%M"
                datetime_timezone "America/Lima"
            }
        }
        children
    }
}
