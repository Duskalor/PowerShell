// Orientation layout: portrait monitor (e.g. 1080x1920).
// Two panes stacked. Chrome mirrors work_oldWorld.kdl.
layout {
    tab focus=true {
        pane split_direction="horizontal" {
            pane size="65%" focus=true
            pane size="35%"
        }
    }

    default_tab_template {
        pane size=1 borderless=true {
            plugin location="file:~/.config/zellij/plugins/zjstatus.wasm" {
                format_left   "{mode} #[fg=#f5c2e7,bold]{tabs}"
                format_center "#[fg=#f5c2e7,bold]{session}"
                format_right  "{command_git_branch} {datetime}"
                format_space  ""

                border_enabled  "false"
                border_char     "─"
                border_format   "#[fg=#1e1e2e]{char}"  
                border_position "top"
                mode_normal  "#[bg=#94e2d5] "  
                mode_tmux    "#[bg=#f38ba8] "  

                tab_normal   "#[fg=#cdd6f4]{index}:{name} "
                tab_active   "#[fg=#eba0ac,bold,italic]{index}:{name} "
                command_git_branch_command     "git rev-parse --abbrev-ref HEAD"
                command_git_branch_format      "#[fg=#94e2d5] {stdout} "  
                command_git_branch_interval    "10"
                command_git_branch_rendermode  "static"

                datetime        "#[fg=#cdd6f4,bold] {format} "  
                datetime_format "%A, %d %b %Y %H:%M"
                datetime_timezone "America/Lima"
            }
        }
        children
    }
}
