{
  "C_Cpp.default.compilerPath": "c:\\mingw64\\bin\\aarch64-w64-mingw32-c++.exe",
  "[astro]": {
    "editor.defaultFormatter": "astro-build.astro-vscode",
  },
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharp",
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
  },
  "[python]": {
    "editor.formatOnType": true,
  },
  "cSpell.checkOnlyEnabledFileTypes": false,
  "cSpell.language": "es",
  "cSpell.userWords": [
    "backspace",
    "cart",
    "chikistrikis",
    "cliente",
    "conversación",
    "creamos",
    "dependencias",
    "entorno",
    "escribes",
    "escribir",
    "infinito",
    "interfaz",
    "leer",
    "mensajes",
    "necesarias",
    "openai",
    "para",
    "traemos",
    "whatsapp",
    "Whatsapp",
  ],
  "chat.tools.autoApprove": true,
  "console-ninja.featureSet": "Community",
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.codeActionsOnSave": {},
  "editor.cursorBlinking": "expand",
  "editor.cursorWidth": 3,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "'Cascadia Code PL ExtraLight',Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.guides.bracketPairs": true,
  "editor.language.brackets": [],
  "editor.linkedEditing": true,
  "editor.suggest.showWords": false,
  "editor.tabSize": 2,
  "editor.unicodeHighlight.allowedCharacters": {
    "ó": true,
  },
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
  },
  "errorLens.alignMessage": {
    "end": 0,
    "minimumMargin": 0,
    "padding": [0, 0],
    "start": 0,
    "useFixedPosition": true,
  },
  "errorLens.codeLensOnClick": "showProblemsView",
  "errorLens.excludeBySource": ["eslint(semi)", "eslint(no-undef)"],
  "errorLens.lintFilePaths": {
    "Stylelint": [
      "**/*.stylelintrc",
      "**/*.stylelintrc.{cjs,js,json,yaml,yml}",
      "**/*stylelint.config.{cjs,js}",
      "**/*package.json",
    ],
    "eslint": ["**/*.eslintrc.{js,cjs,yaml,yml,json}", "**/*package.json"],
  },
  "eslint.codeActionsOnSave.rules": null,
  "eslint.enable": true,
  "eslint.options": {
    "overrideConfigFile": "./eslint.config.js",
  },
  "eslint.run": "onType",
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
  ],
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "*.cs": "${capture}.designer.cs,${capture}.g.cs,${capture}.generated.cs,${capture}.run.json,${capture}.settings.json,${capture}.settings.*.json",
    "*.cshtml": "${capture}.cshtml.cs,${capture}.cshtml.css",
    "*.csproj": "${capture}.csproj.user",
    "*.db": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.json": "${capture}.Development.json",
    "*.jsx": "${capture}.js",
    "*.razor": "${capture}.razor.cs,${capture}.razor.css",
    "*.resx": "${capture}.Designer.cs",
    "*.s3db": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.sqlite": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.ts": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "*.xaml": "${capture}.xaml.cs",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "tsconfig.json": "tsconfig.*.json",
  },
  "java.jdt.ls.java.home": "C:\\Program Files\\Java\\jdk-24",
  "java.configuration.runtimes": [
    {
      "name": "JavaSE-24",
      "path": "C:\\Program Files\\Java\\jdk-24",
      "default": true,
    },
  ],
  "geminicodeassist.updateChannel": "Insiders",
  "git.autofetch": true,
  "git.openRepositoryInParentFolders": "never",
  "git.suggestSmartCommit": false,
  "github.copilot.enable": {
    "*": false,
    "astro": true,
    "json": false,
    "markdown": false,
    "plaintext": false,
    "scminput": false,
    "typescript": false,
  },
  "grunt.autoDetect": "on",
  "intelephense.phpdoc.functionTemplate": {
    "summary": "$1",
    "tags": [
      "@param ${1:$SYMBOL_TYPE} $SYMBOL_NAME $2",
      "@return ${1:$SYMBOL_TYPE} $2",
      "@throws ${1:$SYMBOL_TYPE} $2",
    ],
  },
  "interactiveWindow.executeWithShiftEnter": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "liveServer.settings.donotShowInfoMsg": true,
  "lldb.suppressUpdateNotifications": true,
  "oneDarkPro.bold": true,
  "oneDarkPro.editorTheme": "One Dark Pro Darker",
  "oneDarkPro.vivid": true,
  "php.suggest.basic": true,
  "php.validate.enable": true,
  "prettier.jsxSingleQuote": true,
  "prettier.singleQuote": true,
  "prisma.hidePrisma6Prompts": true,
  "prisma.showPrismaDataPlatformNotification": false,
  "security.allowedUNCHosts": ["wsl.localhost"],
  "security.workspace.trust.untrustedFiles": "open",
  "supermaven.allowGitignore": true,
  "supermaven.enable": {
    "*": true,
  },
  "supermaven.otherWarning": false,
  "symbols.hidesExplorerArrows": false,
  "terminal.integrated.env.osx": {},
  "terminal.integrated.env.windows": {},
  "terminal.integrated.suggest.enabled": false,
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "vsicons.dontShowNewVersionMessage": true,
  "workbench.colorTheme": "One Dark Pro Darker",
  "workbench.editorAssociations": {
    "*.ipynb": "jupyter.notebook",
  },
  "workbench.iconTheme": "symbols",
  "workbench.productIconTheme": "fluent-icons",
  "redhat.telemetry.enabled": true,
  "editor.largeFileOptimizations": false,
}
