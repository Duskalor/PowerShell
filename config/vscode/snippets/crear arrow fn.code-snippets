    "prefix": "rdx",
    "body": [
      " import {createSlice} from '@reduxjs/toolkit' ",
      "",
      "export const ${1:templace}Slice = createSlice({",
      "name : '${1:templace}',",
      "initialState: {",
      " counter: 10",
      "},",
      "reducers: {",
      " increment: (state, /* action */ ) => {",
